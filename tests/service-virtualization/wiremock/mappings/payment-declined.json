{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/payments/authorize",
    "bodyPatterns": [
      {"matchesJsonPath": "$[?(@.amount >= 100000)]"}
    ]
  },
  "response": {
    "status": 402,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {
      "code": "PAYMENT_DECLINED",
      "message": "Authorization declined"
    }
  }
}

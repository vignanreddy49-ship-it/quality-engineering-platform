{
  "title": "ShopSphere API - Quality Signals",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{"expr": "sum(rate(shopsphere_http_requests_total[1m]))", "legendFormat": "requests/sec"}]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "targets": [{"expr": "sum(rate(shopsphere_http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx/sec"}]
    },
    {
      "type": "timeseries",
      "title": "Average Request Duration",
      "targets": [{"expr": "sum(rate(shopsphere_http_request_duration_seconds_total[5m])) / sum(rate(shopsphere_http_requests_total[5m]))", "legendFormat": "avg seconds"}]
    }
  ]
}

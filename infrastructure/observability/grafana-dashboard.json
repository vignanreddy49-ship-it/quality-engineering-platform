{
  "title": "ShopSphere API - Quality Signals",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "targets": [{"expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "requests/sec"}]
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx/sec"}]
    },
    {
      "type": "timeseries",
      "title": "P95 Request Duration",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    }
  ]
}
